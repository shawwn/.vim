"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
" configure search.
"------------------------------------------------------
" highlight, and search incrementally as we type.
set hlsearch
set incsearch
" ignore case for the purposes of searching;  however if we 
" use an uppercase character, then treat it as case-sensitive.
set smartcase
set ignorecase
"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

set ideajoin

"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
" leader mappings.
"------------------------------------------------------
" use space as the leader key.  this must come before any
" mapping below that uses <leader>, since the leader is
" expanded when the mapping is defined, not when it runs.
let mapleader = " "
" toggle distraction free mode: hides the tool windows, tabs,
" and gutter.  the same key exits it.  swap the action for
" ToggleZenMode to get distraction free plus full screen.
nnoremap <leader>a :action ToggleDistractionFreeMode<CR>
nnoremap <leader>z :action ToggleZenMode<CR>
"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

" After pressing ctrl-B (go to definition), let ctrl-T take you back
nnoremap <C-t> <C-o>
